# Copy to .env and fill in. Never commit .env.

# The domain players' clients talk to (its A record must point at this server).
API_DOMAIN=api.example.com

# Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Store link for the in-game Support / Unlock buttons (Ko-fi, Tebex webstore, ...).
STORE_URL=

# Tebex: Developers > Webhooks secret. Leave empty until the store is set up.
TEBEX_SECRET=
# Optional package map, e.g. {"6012345":["supporter"]}
TEBEX_PACKAGES=

# Hide unowned paid cosmetics from other players. Keep 0 while everything is free.
ENFORCE_ENTITLEMENTS=0

# First sign-ins that get the Founder cape.
FOUNDER_LIMIT=1000

# Generic signed webhook for other payment providers (optional).
WEBHOOK_SECRET=
